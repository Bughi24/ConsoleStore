@model ConsoleStore.Models.Order

@{
    ViewData["Title"] = "Order Details #" + Model.OrderId;
}

<style>
    .order-container {
        animation: fadeIn 0.6s ease-out;
    }

    {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .invoice-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .invoice-header {
        background: linear-gradient(135deg, #121212 0%, #333 100%);
        color: white;
        padding: 30px;
    }

    .info-label {
        color: #888;
        font-size: 0.85rem;
        text-transform: uppercase;
        font-weight: 600;
        margin-bottom: 2px;
    }

    .info-value {
        font-weight: 500;
        color: #333;
    }

    .table-custom thead {
        background-color: #f8f9fa;
        border-top: 1px solid #eee;
    }

    .product-img {
        width: 50px;
        height: 50px;
        object-fit: contain;
        background: white;
        border-radius: 8px;
        padding: 5px;
    }

    .total-box {
        background-color: #f8f9fa;
        border-radius: 12px;
        padding: 20px;
    }

    .status-badge {
        background: rgba(255,255,255,0.2);
        padding: 5px 15px;
        border-radius: 50px;
        font-size: 0.9rem;
    }
</style>

<div class="container order-container py-5">
    <div class="mb-4">
        <a href="/Orders/Index" class="text-decoration-none text-muted">
            <i class="bi bi-arrow-left"></i> Back to History
        </a>
    </div>

    <div class="card invoice-card">
        <div class="invoice-header d-flex justify-content-between align-items-center">
            <div>
                <h2 class="mb-1">Order #@Model.OrderId</h2>
                <p class="mb-0 opacity-75">Placed on @Model.OrderDat.ToString("dd MMM yyyy, HH:mm")</p>
            </div>
            <div class="status-badge">
                <i class="bi bi-check2-circle me-1"></i> Confirmed
            </div>
        </div>

        <div class="card-body p-4 p-md-5">
            <div class="row mb-5">
                <div class="col-md-6">
                    <div class="info-label">Customer Details</div>
                    <div class="info-value fs-5">@Model.CustomerName</div>
                    <div class="info-value">@Model.Phone</div>
                </div>
                <div class="col-md-6 text-md-end">
                    <div class="info-label">Shipping Address</div>
                    <div class="info-value">@Model.Address</div>
                    <div class="info-value">@Model.City</div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle table-custom">
                    <thead>
                        <tr>
                            <th class="py-3">Product</th>
                            <th class="py-3 text-center">Qty</th>
                            <th class="py-3 text-end">Unit Price</th>
                            <th class="py-3 text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="py-3">
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(item.Product.ImagePath))
                                        {
                                            <img src="@item.Product.ImagePath" class="product-img border me-3 shadow-sm" />
                                        }
                                        <span class="fw-bold">@item.Product.Name</span>
                                    </div>
                                </td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end text-muted">@item.Price.ToString("0.00") €</td>
                                <td class="text-end fw-bold">@((item.Price * item.Quantity).ToString("0.00")) €</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="row mt-4">
                <div class="col-md-6">
                    <p class="small text-muted italic">Thank you for choosing Console Store! Your order is being prepared for shipping.</p>
                </div>
                <div class="col-md-6 text-end">
                    <div class="total-box ms-auto" style="max-width: 300px;">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Net Total:</span>
                            <span>@Model.Items.Sum(i => i.Price * i.Quantity).ToString("0.00") €</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                            <span class="text-muted">Shipping:</span>
                            <span class="text-success fw-bold">FREE</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <h4 class="mb-0 fw-bold text-dark">Total:</h4>
                            <h4 class="mb-0 fw-bold text-primary">@Model.Items.Sum(i => i.Price * i.Quantity).ToString("0.00") €</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-footer bg-white p-4 border-top-0 d-flex justify-content-center gap-3">
            <a href="/Store" class="btn btn-primary rounded-pill px-4">
                Continue Shopping
            </a>
        </div>
    </div>
</div>