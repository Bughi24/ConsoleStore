@model IEnumerable<ConsoleStore.Models.ProductScoreViewModel>

<div class="container mt-4">
    <h2 class="fw-bold mb-4"><i class="bi bi-cpu"></i> Rezultate Căutare Avansată (Lucene)</h2>
    <p class="text-muted">Căutare după: <strong>@ViewBag.Query</strong></p>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-12">
                <div class="card shadow-sm border-start border-info border-4">
                    <div class="card-body d-flex align-items-center">
                        <img src="@item.Product.ImagePath" style="width: 80px; height: 80px; object-fit: contain;" class="me-3">
                        <div class="flex-grow-1">
                            <h5 class="fw-bold mb-1">@item.Product.Name</h5>
                            <p class="small text-muted mb-0">Scor Relevanță: <span class="badge bg-success">@item.Score.ToString("F4")</span></p>
                        </div>
                        <div class="text-end">
                            <h4 class="text-primary fw-bold">@item.Product.Price €</h4>
                            <a href="/Store/Details/@item.Product.ProductId" class="btn btn-sm btn-outline-dark">Vezi Detalii</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>