@model ConsoleStore.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="text-center mb-5">
                <div class="category-delete-icon shadow-sm mb-4">
                    <i class="bi bi-exclamation-triangle-fill text-danger"></i>
                </div>
                <h1 class="fw-bold text-dark">Delete Category?</h1>
                <p class="text-muted fs-5">You are about to permanently remove this category. Please confirm if this is intended.</p>
            </div>

            <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                <div class="card-header bg-danger bg-opacity-10 border-0 py-3 ps-4">
                    <h5 class="m-0 fw-bold text-danger small text-uppercase">Summary of item to be deleted</h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label class="small text-muted text-uppercase d-block mb-1">Category Name</label>
                        <h4 class="fw-bold text-dark mb-0">@Model.Name</h4>
                    </div>
                    <div>
                        <label class="small text-muted text-uppercase d-block mb-1">Description</label>
                        <p class="text-dark mb-0">
                            @if (!string.IsNullOrEmpty(Model.Description))
                            {
                                @Model.Description
                            }
                            else
                            {
                                <span class="text-muted fst-italic">No description available.</span>
                            }
                        </p>
                    </div>
                </div>
            </div>

            <div class="card border-danger border-opacity-25 bg-white rounded-4 shadow-sm">
                <div class="card-body p-4 text-center">
                    <p class="small text-muted mb-4">
                        <i class="bi bi-info-circle me-1"></i>
                        Check if any products are still assigned to <strong>@Model.Name</strong> before proceeding.
                    </p>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="CategoryId" />
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg rounded-pill fw-bold py-3 shadow">
                                <i class="bi bi-trash3-fill me-2"></i>Permanently Delete Category
                            </button>
                            <a asp-action="Index" class="btn btn-light rounded-pill py-2">
                                No, Keep it (Back to List)
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #fcfcfc;
    }

    .category-delete-icon {
        width: 80px;
        height: 80px;
        background-color: #fff;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        border: 2px solid #fee2e2;
    }

    .card {
        border-radius: 1rem;
    }

    .btn-danger {
        transition: all 0.3s ease;
    }

        .btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(220, 53, 69, 0.3) !important;
        }
</style>