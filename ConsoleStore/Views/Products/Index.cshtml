@model IEnumerable<ConsoleStore.Models.Product>

@{
    ViewData["Title"] = "Inventory Management";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-dark">Product Inventory</h1>
            <p class="text-muted">Manage your store's stock, prices, and documentation.</p>
        </div>
        <a asp-action="Create" class="btn btn-success btn-lg shadow-sm rounded-pill">
            <i class="bi bi-plus-lg me-2"></i>Add New Product
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Product</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Stock Status</th>
                            <th>Supplier</th>
                            <th>Media</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <img src="@item.ImagePath" class="rounded-3 me-3"
                                             style="width: 50px; height: 50px; object-fit: cover; background: #f8f9fa;" />
                                        <div>
                                            <div class="fw-bold text-dark">@item.Name</div>
                                            <div class="small text-muted text-truncate" style="max-width: 150px;">
                                                @item.Description
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark opacity-75">@item.Category.Name</span>
                                </td>
                                <td class="fw-bold text-primary">@item.Price.ToString("0.00") €</td>
                                <td>
                                    @if (item.Stock <= 0)
                                    {
                                        <span class="badge bg-danger rounded-pill">Out of Stock</span>
                                    }
                                    else if (item.Stock <= 5)
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill">Low Stock (@item.Stock)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success rounded-pill">@item.Stock in Stock</span>
                                    }
                                </td>
                                <td class="small">@item.Supplier</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.PdfPath))
                                    {
                                        <a href="@item.PdfPath" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill">
                                            <i class="bi bi-file-pdf text-danger"></i> PDF
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No Doc</span>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <div class="btn-group shadow-sm rounded">
                                        <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-white btn-sm border" title="Edit">
                                            <i class="bi bi-pencil text-primary"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-white btn-sm border" title="Details">
                                            <i class="bi bi-eye text-info"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.ProductId" class="btn btn-white btn-sm border" title="Delete">
                                            <i class="bi bi-trash text-danger"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: rgba(16, 185, 129, 0.05); 
        transition: background-color 0.2s ease;
    }

    .btn-group .btn {
        padding: 0.4rem 0.7rem;
        background-color: #fff;
    }

        .btn-group .btn:hover {
            background-color: #f8f9fa;
        }

    .table thead th {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
        border-bottom-width: 1px;
    }
</style>