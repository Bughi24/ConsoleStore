@model ConsoleStore.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<h1>Edit</h1>
<h4>Product</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="ProductId" />
            <input type="hidden" asp-for="ImagePath" />
            <input type="hidden" asp-for="PdfPath" />

            <div class="form-group mb-2">
                <label asp-for="Name" class="control-label fw-bold"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="Description" class="control-label fw-bold"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="Price" class="control-label fw-bold"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="fw-bold text-primary">Update Image</label>
                <input type="file" name="imageFile" class="form-control" />

                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <div class="mt-2">
                        <img src="@Model.ImagePath" style="max-height:100px;" class="img-thumbnail" />
                        <small class="d-block text-muted">Current image</small>
                    </div>
                }
            </div>

            <div class="card card-multimedia mt-3 mb-4 bg-light shadow-sm">
                <div class="card-body">
                    <h6 class="card-title text-info border-bottom pb-2">
                        <i class="bi bi-gear-wide-connected"></i> Multimedia Operations
                    </h6>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="applyBlur" id="blur" value="true">
                        <label class="form-check-label" for="blur">Apply Blur</label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="applyGrayscale" id="gray" value="true">
                        <label class="form-check-label" for="gray">Grayscale (Retro Effect)</label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="rotateImage" id="rotate" value="true">
                        <label class="form-check-label" for="rotate">Rotate 90°</label>
                    </div>
                </div>
            </div>

            <div class="form-group mb-3">
                <label class="fw-bold text-primary">Update Product PDF</label>
                <input type="file" name="pdfFile" class="form-control" accept=".pdf" />
            </div>

            <div class="form-group mb-3">
                <label class="fw-bold text-primary">Upload Presentation Video</label>
                <input type="file" name="videoFile" class="form-control" accept="video/mp4,video/webm" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="CategoryId" class="control-label fw-bold"></label>
                <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.CategoryId"></select>
            </div>

            <div class="form-group">
                <input type="submit" value="Save Changes" class="btn btn-success btn-lg w-100" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-link">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}