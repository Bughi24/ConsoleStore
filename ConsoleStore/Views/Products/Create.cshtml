@model ConsoleStore.Models.Product

@{
    ViewData["Title"] = "Add New Product";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark"><i class="bi bi-plus-circle me-2 text-primary"></i>Add New Product</h2>
            <p class="text-muted">Fill in the details to list a new item in the ConsoleStore inventory.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
            <i class="bi bi-arrow-left me-1"></i> Back to Inventory
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <form asp-action="Create" enctype="multipart/form-data" method="post" class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-0 m-0"></div>

                <div class="card-body p-4 p-md-5">
                    <div class="mb-5">
                        <h5 class="fw-bold text-primary mb-4 border-bottom pb-2">
                            <i class="bi bi-info-square me-2"></i>General Information
                        </h5>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label fw-semibold"></label>
                                <input asp-for="Name" class="form-control" placeholder="e.g. PlayStation 5 DualSense Controller" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="form-label fw-semibold">Category</label>
                                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
                                    <option value="">-- Select Category --</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-semibold"></label>
                                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief marketing description..."></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Specification" class="form-label fw-semibold"></label>
                                <textarea asp-for="Specification" class="form-control" rows="2" placeholder="Technical specs..."></textarea>
                                <span asp-validation-for="Specification" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-5 p-4 bg-light rounded-3">
                        <h5 class="fw-bold text-primary mb-4 border-bottom pb-2 border-primary-subtle">
                            <i class="bi bi-currency-dollar me-2"></i>Pricing & Logistics
                        </h5>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="Price" class="form-label fw-semibold">Price (€)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white">€</span>
                                    <input asp-for="Price" class="form-control" type="number" step="0.01" />
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Stock" class="form-label fw-semibold"></label>
                                <input asp-for="Stock" class="form-control" type="number" />
                                <span asp-validation-for="Stock" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Supplier" class="form-label fw-semibold"></label>
                                <input asp-for="Supplier" class="form-control" />
                                <span asp-validation-for="Supplier" class="text-danger small"></span>
                            </div>
                            <div class="col-md-12 mt-3">
                                <label asp-for="DeliveryMethod" class="form-label fw-semibold"></label>
                                <input asp-for="DeliveryMethod" class="form-control" placeholder="e.g. Courier, Digital Download" />
                                <span asp-validation-for="DeliveryMethod" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h5 class="fw-bold text-primary mb-4 border-bottom pb-2">
                            <i class="bi bi-images me-2"></i>Media Assets
                        </h5>
                        <div class="row g-4">
                            <div class="col-md-4">
                                <div class="p-3 border rounded-3 bg-white h-100">
                                    <label class="form-label fw-bold d-block mb-2"><i class="bi bi-image text-info"></i> Product Image</label>
                                    <input type="file" name="imageFile" class="form-control form-control-sm" accept="image/*" />
                                    <div class="form-text small">High-res JPG/PNG recommended.</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 border rounded-3 bg-white h-100">
                                    <label class="form-label fw-bold d-block mb-2"><i class="bi bi-file-earmark-pdf text-danger"></i> PDF Guide</label>
                                    <input type="file" name="pdfFile" class="form-control form-control-sm" accept=".pdf" />
                                    <div class="form-text small">Manual or technical sheet.</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 border rounded-3 bg-white h-100 border-primary border-opacity-25">
                                    <label class="form-label fw-bold d-block mb-2 text-primary"><i class="bi bi-play-circle"></i> Presentation Video</label>
                                    <input type="file" name="videoFile" class="form-control form-control-sm" accept="video/mp4,video/webm" />
                                    <div class="form-text small">MP4 or WebM (Max 50MB).</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-white p-4 text-end border-top">
                    <button type="submit" class="btn btn-primary btn-lg px-5 rounded-pill shadow">
                        <i class="bi bi-check-lg me-2"></i>Create Product
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .form-control:focus, .form-select:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.1);
    }

    .card {
        border: none !important;
    }

    textarea {
        resize: none;
    }

    .form-text {
        color: #999;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}