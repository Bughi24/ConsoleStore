@model ConsoleStore.Models.Category

@{
    ViewData["Title"] = "Edit Category";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="d-flex align-items-center mb-4">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-circle me-3">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h2 class="fw-bold m-0 text-dark">Edit Category</h2>
            </div>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h5 class="fw-bold text-primary m-0">
                        <i class="bi bi-tag-fill me-2"></i>Category Details
                    </h5>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 rounded-3"></div>
                        <input type="hidden" asp-for="CategoryId" />

                        <div class="form-group mb-3">
                            <label asp-for="Name" class="form-label fw-semibold small text-muted text-uppercase"></label>
                            <input asp-for="Name" class="form-control form-control-lg shadow-sm border-light-subtle" placeholder="e.g. Next-Gen Consoles" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Description" class="form-label fw-semibold small text-muted text-uppercase"></label>
                            <textarea asp-for="Description" class="form-control shadow-sm border-light-subtle" rows="4" placeholder="Briefly describe what products belong here..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow-sm py-2 fw-bold">
                                <i class="bi bi-check2-circle me-2"></i>Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-link btn-sm text-decoration-none text-muted">
                                Cancel and go back
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="mt-4 p-3 bg-light rounded-3 border border-dashed text-center">
                <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    Changing the category name will automatically update all linked products.
                </small>
            </div>
        </div>
    </div>
</div>

<style>
   
    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.1);
    }

 </style>