@page
@model LoginModel

@{
    ViewData["Title"] = "Welcome Back";
    Layout = "/Views/Shared/_Layout.cshtml"; 
}

<div class="container-fluid p-0 my-n4">
    <div class="row g-0 min-vh-100">
        <div class="col-lg-7 d-none d-lg-block position-relative">
            <div class="auth-bg-overlay"></div>
            <img src="https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=2070&auto=format&fit=crop"
                 class="auth-bg-img" alt="Gaming Wallpaper">
            <div class="auth-welcome-text p-5">
                <h1 class="display-3 fw-bold text-white">Console<span class="text-success">Store</span></h1>
                <p class="lead text-white opacity-75">Your journey to the next level starts here.</p>
            </div>
        </div>

        <div class="col-lg-5 d-flex align-items-center bg-white shadow-lg">
            <div class="p-5 w-100 mx-auto" style="max-width: 500px;">
                <div class="text-center mb-5 d-lg-none">
                    <h2 class="fw-bold text-dark">Console<span class="text-success">Store</span></h2>
                </div>

                <h3 class="fw-bold mb-2">@ViewData["Title"]</h3>
                <p class="text-muted mb-4">Please enter your credentials to access your account.</p>

                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control rounded-3" autocomplete="username" placeholder="name@example.com" />
                        <label asp-for="Input.Email">Email Address</label>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control rounded-3" autocomplete="current-password" placeholder="password" />
                        <label asp-for="Input.Password">Password</label>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            <label class="form-check-label text-muted small" asp-for="Input.RememberMe">
                                @Html.DisplayNameFor(m => m.Input.RememberMe)
                            </label>
                        </div>
                        <a id="forgot-password" asp-page="./ForgotPassword" class="small text-success text-decoration-none fw-bold">Forgot?</a>
                    </div>

                    <button id="login-submit" type="submit" class="w-100 btn btn-success btn-lg rounded-pill py-3 fw-bold shadow-sm mb-4">
                        LOG IN <i class="bi bi-box-arrow-in-right ms-2"></i>
                    </button>

                    <div class="text-center">
                        <p class="text-muted small">
                            Don't have an account?
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-success fw-bold text-decoration-none">Sign Up Now</a>
                        </p>
                    </div>

                    @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                    {
                        <hr class="my-4">
                        <p class="text-center text-muted small mb-3">Or continue with</p>
                        <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                            <div class="d-flex gap-2 justify-content-center">
                                @foreach (var provider in Model.ExternalLogins!)
                                {
                                    <button type="submit" class="btn btn-outline-dark rounded-pill px-4" name="provider" value="@provider.Name">
                                        @provider.DisplayName
                                    </button>
                                }
                            </div>
                        </form>
                    }
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .auth-bg-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        position: absolute;
    }

    .auth-bg-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(to right, rgba(0,0,0,0.8), transparent);
        z-index: 1;
    }

    .auth-welcome-text {
        position: absolute;
        bottom: 10%;
        left: 5%;
        z-index: 2;
    }

    .form-control:focus {
        border-color: #198754;
        box-shadow: 0 0 0 0.25rem rgba(25, 135, 84, 0.1);
    }

    .min-vh-100 {
        min-height: 100vh !important;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}