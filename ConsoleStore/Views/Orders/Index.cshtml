@model IEnumerable<ConsoleStore.Models.Order>

@{
    ViewData["Title"] = "Order History";
}

<div class="container py-5 reveal-anim">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h2 class="fw-bold m-0"><i class="bi bi-clock-history me-2"></i>Your Orders</h2>
        <span class="badge bg-secondary rounded-pill">@Model.Count() orders found</span>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-cart-x display-1 text-muted"></i>
            <p class="mt-3 lead">You haven't placed any orders yet.</p>
            <a href="/Store" class="btn btn-primary">Start Shopping</a>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var o in Model)
            {
                <div class="col-12">
                    <div class="card history-card shadow-sm p-3 mb-2">
                        <div class="card-body d-flex flex-wrap align-items-center justify-content-between">

                            <div class="flex-grow-1">
                                <small class="text-uppercase text-muted d-block mb-1">Order Identifier</small>
                                <span class="order-number fs-5">#@o.OrderId</span>
                                <div class="text-muted small">
                                    <i class="bi bi-calendar3 me-1"></i> @o.OrderDat.ToString("dd MMM yyyy, HH:mm")
                                </div>
                            </div>

                            <div class="px-md-5">
                                <span class="badge rounded-pill bg-light text-dark border px-3 py-2">
                                    <i class="bi bi-box-seam me-1 text-primary"></i> Delivered
                                </span>
                            </div>

                            <div class="text-md-end me-md-5 mt-3 mt-md-0">
                                <small class="text-muted d-block">Total Amount</small>
                                <span class="price-tag">@o.Items.Sum(i => i.Price * i.Quantity).ToString("0.00") €</span>
                            </div>

                            <div class="mt-3 mt-md-0">
                                <a asp-controller="Orders"
                                   asp-action="Details"
                                   asp-route-id="@o.OrderId"
                                   class="btn btn-outline-primary rounded-pill px-4 btn-hover-anim">
                                    View Details <i class="bi bi-chevron-right ms-1"></i>
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>