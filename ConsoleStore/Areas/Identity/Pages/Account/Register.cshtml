@page
@model RegisterModel
@{
    ViewData["Title"] = "Join the Guild";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid p-0 my-n4">
    <div class="row g-0 min-vh-100">
        <div class="col-lg-5 d-flex align-items-center bg-white shadow-lg order-2 order-lg-1">
            <div class="p-5 w-100 mx-auto" style="max-width: 500px;">
                <div class="text-center mb-4 d-lg-none">
                    <h2 class="fw-bold text-dark">Console<span class="text-success">Store</span></h2>
                </div>

                <h3 class="fw-bold mb-2">@ViewData["Title"]</h3>
                <p class="text-muted mb-4">Create your account to start collecting rewards and tracking orders.</p>

                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control rounded-3" autocomplete="username" placeholder="name@example.com" />
                        <label asp-for="Input.Email">Email Address</label>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control rounded-3" autocomplete="new-password" placeholder="password" />
                        <label asp-for="Input.Password">Password</label>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="Input.ConfirmPassword" class="form-control rounded-3" autocomplete="new-password" placeholder="password" />
                        <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button id="registerSubmit" type="submit" class="w-100 btn btn-primary btn-lg rounded-pill py-3 fw-bold shadow-sm mb-4">
                        CREATE ACCOUNT <i class="bi bi-person-plus-fill ms-2"></i>
                    </button>

                    <div class="text-center">
                        <p class="text-muted small">
                            Already a member?
                            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-primary fw-bold text-decoration-none">Log In instead</a>
                        </p>
                    </div>

                    @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                    {
                        <hr class="my-4">
                        <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                            <div class="d-flex gap-2 justify-content-center">
                                @foreach (var provider in Model.ExternalLogins!)
                                {
                                    <button type="submit" class="btn btn-outline-dark rounded-pill px-4" name="provider" value="@provider.Name">
                                        Sign up with @provider.DisplayName
                                    </button>
                                }
                            </div>
                        </form>
                    }
                </form>
            </div>
        </div>

        <div class="col-lg-7 d-none d-lg-block position-relative order-1 order-lg-2">
            <div class="auth-bg-overlay-right"></div>
            <img src="https://images.unsplash.com/photo-1550745165-9bc0b252726f?q=80&w=2070&auto=format&fit=crop"
                 class="auth-bg-img" alt="Retro Gaming Setup">
            <div class="auth-welcome-text-right p-5 text-end w-100">
                <h1 class="display-3 fw-bold text-white">Join the <span class="text-primary">Arena</span></h1>
                <p class="lead text-white opacity-75">Get exclusive access to pre-orders and member-only discounts.</p>
            </div>
        </div>
    </div>
</div>

<style>
    .auth-bg-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        position: absolute;
    }

    .auth-bg-overlay-right {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(to left, rgba(0,0,0,0.8), transparent);
        z-index: 1;
    }

    .auth-welcome-text-right {
        position: absolute;
        bottom: 10%;
        right: 0;
        z-index: 2;
    }

    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.1);
    }

    .min-vh-100 {
        min-height: 100vh !important;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}