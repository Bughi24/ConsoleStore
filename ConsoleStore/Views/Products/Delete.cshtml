@model ConsoleStore.Models.Product  

@{
    ViewData["Title"] = "Delete Product";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="text-center mb-5">
                <div class="display-1 text-danger mb-3">
                    <i class="bi bi-exclamation-octagon"></i>
                </div>
                <h1 class="fw-bold text-dark">Confirm Deletion</h1>
                <p class="text-muted fs-5">Are you sure you want to permanently remove this product? This action cannot be undone.</p>
            </div>

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4">
                <div class="row g-0">
                    <div class="col-md-4 bg-light d-flex align-items-center justify-content-center p-3">
                        <img src="@Model.ImagePath" class="img-fluid rounded-3 shadow-sm" style="max-height: 250px; object-fit: contain;" alt="@Model.Name" />
                    </div>
                    
                    <div class="col-md-8">
                        <div class="card-body p-4">
                            <h4 class="fw-bold text-primary mb-1">@Model.Name</h4>
                            <span class="badge bg-info text-dark mb-3">@Model.Category.Name</span>
                            
                            <div class="row g-3">
                                <div class="col-6">
                                    <small class="text-muted d-block">Price</small>
                                    <span class="fw-bold">@Model.Price.ToString("0.00") €</span>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">Stock Available</small>
                                    <span class="fw-bold">@Model.Stock pcs</span>
                                </div>
                                <div class="col-12 border-top pt-2 mt-3">
                                    <small class="text-muted d-block">Description Summary</small>
                                    <p class="small text-dark mb-0">@Model.Description</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card bg-danger bg-opacity-10 border-danger border-opacity-25 rounded-3">
                <div class="card-body d-flex align-items-center justify-content-between p-4">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-info-circle-fill text-danger fs-4 me-3"></i>
                        <span class="text-danger fw-semibold">Careful! All associated orders and wishlist items might be affected.</span>
                    </div>
                    <form asp-action="Delete" method="post" class="d-flex gap-2">
                        <input type="hidden" name="ProductId" value="@Model.ProductId" />
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4">Cancel</a>
                        <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm">
                            <i class="bi bi-trash me-2"></i>Permanently Delete
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>