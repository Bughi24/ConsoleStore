@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
}

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card border-0 shadow-lg rounded-4 p-5">
                <div class="mb-4">
                    <div class="logout-icon-circle bg-light text-danger mx-auto mb-3">
                        <i class="bi bi-door-open-fill fs-1"></i>
                    </div>
                    <h2 class="fw-bold text-dark">@ViewData["Title"]</h2>
                </div>

                @{
                    if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <p class="text-muted mb-4">Are you sure you want to end your gaming session?</p>

                        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-danger btn-lg rounded-pill fw-bold py-3 shadow-sm">
                                    Confirm Logout <i class="bi bi-box-arrow-right ms-2"></i>
                                </button>
                                <a href="/" class="btn btn-link text-decoration-none text-muted mt-2">
                                    No, take me back to store
                                </a>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="py-3">
                            <i class="bi bi-check-circle-fill text-success fs-2 mb-3 d-block"></i>
                            <h4 class="fw-bold">Success!</h4>
                            <p class="text-muted mb-4">You have successfully logged out of the application.</p>
                            <a href="/" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow">
                                Return to Home
                            </a>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f8f9fa;
        background-image: radial-gradient(#dee2e6 0.5px, transparent 0.5px);
        background-size: 20px 20px;
    }

    .logout-icon-circle {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .card {
        transition: transform 0.3s ease;
    }

    .btn-danger {
        transition: all 0.3s ease;
    }

        .btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(220, 53, 69, 0.2) !important;
        }
</style>