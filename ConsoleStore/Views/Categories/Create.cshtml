@model ConsoleStore.Models.Category

@{
    ViewData["Title"] = "Add New Category";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="d-flex align-items-center mb-4">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-circle me-3 shadow-sm">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <div>
                    <h2 class="fw-bold m-0 text-dark">New Category</h2>
                    <p class="text-muted small m-0">Define a new group for your inventory.</p>
                </div>
            </div>

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-primary py-3 px-4">
                    <h5 class="fw-bold text-white m-0">
                        <i class="bi bi-folder-plus me-2"></i>Category Info
                    </h5>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 rounded-3"></div>

                        <div class="form-group mb-4">
                            <label asp-for="Name" class="form-label fw-bold text-uppercase small text-muted"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-tag"></i></span>
                                <input asp-for="Name" class="form-control form-control-lg border-start-0 ps-0 shadow-none" placeholder="e.g. Virtual Reality" />
                            </div>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Description" class="form-label fw-bold text-uppercase small text-muted"></label>
                            <textarea asp-for="Description" class="form-control shadow-none" rows="4" placeholder="Describe the type of products in this category..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow fw-bold py-3 mb-3">
                                <i class="bi bi-plus-circle-fill me-2"></i>Create Category
                            </button>
                            <a asp-action="Index" class="btn btn-link btn-sm text-decoration-none text-muted text-center">
                                Nevermind, go back
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f4f7f6;
    }

    .card {
        border-radius: 1.25rem;
    }

    .form-control, .input-group-text {
        border-color: #e9ecef;
    }

        .form-control:focus {
            border-color: #0d6efd;
            background-color: #fff;
        }

    .input-group-text {
        color: #adb5bd;
    }

    .btn-primary {
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(13, 110, 253, 0.25) !important;
        }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}