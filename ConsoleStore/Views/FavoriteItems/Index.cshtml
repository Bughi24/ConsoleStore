@model IEnumerable<ConsoleStore.Models.FavoriteItem>

@{
    ViewData["Title"] = "My Wishlist";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h2 class="fw-bold m-0"><i class="bi bi-heart-fill text-danger me-2"></i>My Wishlist</h2>
        <span class="badge bg-dark rounded-pill">@Model.Count() items</span>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 shadow-sm rounded-3 bg-white">
            <i class="bi bi-heartbreak display-1 text-muted"></i>
            <h4 class="mt-3">Your wishlist is lonely...</h4>
            <p class="text-muted">Explore our products and save your favorites here!</p>
            <a href="/Store" class="btn btn-primary px-4 py-2 mt-2 rounded-pill shadow">
                Browse Products
            </a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 wishlist-card shadow-sm">
                        <div class="wishlist-img-container">
                            <img src="@item.Product.ImagePath" class="wishlist-img" alt="@item.Product.Name" />
                        </div>

                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title fw-bold text-dark mb-2">@item.Product.Name</h6>
                            <div class="price-badge mb-3">@item.Product.Price.ToString("0.00") €</div>

                            <div class="mt-auto">
                                <a href="/Store/Details/@item.ProductId" class="btn btn-primary btn-sm w-100 mb-2 rounded-pill shadow-sm">
                                    <i class="bi bi-eye me-1"></i> View Details
                                </a>

                                <a href="/FavoriteItems/Remove/@item.Id" class="btn btn-outline-danger btn-sm w-100 rounded-pill border-0">
                                    <i class="bi bi-x-lg me-1"></i> Remove
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>