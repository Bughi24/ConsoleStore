@model ConsoleStore.Models.Order

<h2>Order #@Model.OrderId</h2>

<p>
    <strong>Date:</strong> @Model.OrderDat <br />
    <strong>Name:</strong> @Model.CustomerName <br />
    <strong>Address:</strong> @Model.Address, @Model.City <br />
    <strong>Phone:</strong> @Model.Phone
</p>

<h3>Products</h3>

<table class="table">
    <thead>
        <tr>
            <th>Product</th>
            <th>Qty</th>
            <th>Price</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Product.Name</td>
                <td>@item.Quantity</td>
                <td>@(item.Price* item.Quantity) €</td>
            </tr>
        }
    </tbody>
</table>

<p class="mt-3">
    <strong>Total: </strong>
    @Model.Items.Sum(i => i.Price * i.Quantity) €
</p>
